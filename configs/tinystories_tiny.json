{
  "model": {
    "vocab_size": 8192,
    "context_length": 128,
    "emb_dim": 256,
    "n_heads": 4,
    "n_layers": 6,
    "dropout": 0.1,
    "qkv_bias": false
  },
  "training": {
    "batch_size": 32,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "max_steps": 2000,
    "eval_every": 100,
    "eval_batches": 20,
    "grad_clip_norm": 1.0,
    "seed": 42,
    "save_every": 100
  }
}
